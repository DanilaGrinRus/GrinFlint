{
  "sourceLanguage": "ru",
  "strings": {
    "\n\nНикому не показывайте эти слова — от них зависит доступ ко всем средствам.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nNever show these words to anyone — they control access to all funds."
          }
        }
      }
    },
    "Автоблокировка": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-lock"
          }
        }
      }
    },
    "Адрес ноды Grin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grin node address"
          }
        }
      }
    },
